# PCC — .env do servidor (copiar para /opt/mwana-pcc/app/.env e preencher a sério)
# NUNCA COMMITAR ESTE FICHEIRO COM VALORES REAIS.

SYSTEM_MODE=PCC
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=TROQUE-ISTO-por-uma-chave-longa-e-aleatoria-so-sua
DJANGO_ALLOWED_HOSTS=pcc.mwanalodge.ao
DJANGO_CORS_ORIGINS=https://pcc.mwanalodge.ao

# Ficheiros — fora da pasta de código, para sobreviverem a um `git pull`/atualização
# (VPS tradicional) ou a um redeploy (Docker/EasyPanel — este caminho já vem fixo
# no Dockerfile via ENV, não precisa de o repetir aqui nesse caso).
DJANGO_STATIC_ROOT=/opt/mwana-pcc/dados/staticfiles
DJANGO_MEDIA_ROOT=/opt/mwana-pcc/dados/media

# Base de dados — o PCC é o registo central de TODOS os clientes: PostgreSQL a
# sério, não SQLite (que é para a instalação de um único cliente).
# No EasyPanel: cria-se um serviço "Postgres" à parte (Add Service > Database) e
# DB_HOST é o NOME desse serviço (ex.: "pcc-db") — os dois ficam na mesma rede
# Docker interna do projeto, resolve-se por nome sozinho. Os outros valores (porta,
# nome da base, utilizador, password) o EasyPanel mostra-os no ecrã do serviço.
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mwana_pcc
DB_USER=mwana_pcc
DB_PASSWORD=TROQUE-ISTO

# Endereço do próprio PCC — o mesmo que se cola no build_instalador.ps1 de cada
# cliente (instalador/pcc_url.txt), e o que o frontend_pcc usa em produção
# (ver "Compilar o frontend" no README ao lado).

# Lista de IPs/redes com acesso à consola (Gestão de Clientes, Wizard, /admin/),
# separados por vírgula — CIDR aceite (ex.: "41.63.12.7,10.8.0.0/24"). Vazio =
# sem esta camada extra (a consola continua a exigir login; ver core/pcc_access.py).
PCC_ALLOWED_IPS=

# SMTP — para o PCC poder mandar e-mail (ex.: notificações de licença). Sem
# EMAIL_HOST_PASSWORD, o envio falha quando for tentado — não impede o resto
# do PCC de funcionar, só essa funcionalidade específica.
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=TROQUE-ISTO
DEFAULT_FROM_EMAIL=noreply@mwanalodge.ao
